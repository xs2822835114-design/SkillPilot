# ===== SkillMap 环境变量模板 =====
# 复制为 .env 后按需填写；.env 不入库（见 .gitignore）

# 环境标识：dev / test / prod
ENV=dev

# PostgreSQL 连接串（阶段 2 起用于 RAG/pgvector；阶段 1 提供则可启用 PostgresSaver 持久化）
DATABASE_URL=postgresql://localhost:5432/skillmap

# LLM（默认 DeepSeek，OpenAI 兼容端点；不配置则阶段 1 走规则兜底回复，保证闭环可运行）
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com

# Checkpointer 后端：auto（有 DATABASE_URL 用 postgres，否则 memory）/ postgres / memory
CHECKPOINTER_BACKEND=auto

# 日志
LOG_LEVEL=INFO

# 业务参数
MESSAGE_MAX_LEN=8000
MAX_ATTACHMENTS=5

# 阶段 2 RAG / Embedding
# EMBEDDING_PROVIDER=off        # off | openai（OpenAI 兼容）；off=本地 hash 嵌入，不依赖外网
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=            # 开启 openai 嵌入时的 key
# EMBEDDING_MODEL=qwen3.7-text-embedding
# EMBEDDING_DIM=1024
# RAG_TOP_K_DEFAULT=5           # 检索默认 top-k
# RAG_CHUNK_SIZE=800            # 分片大小（字符）
# RAG_CHUNK_OVERLAP=100         # 分片重叠

# 阶段 3 用户技术画像
# PROFILE_PRACTICE_WEIGHT=0.6   # practice 在 level 换算中的权重（theory=1-w）
# PROFILE_SOFT_CAP_SKILLS=30    # 画像技能软上限
# PROFILE_MIN_CONFIDENCE=0.4    # 低于该置信度的新技能不进入画像
# PROFILE_LLM_ENABLED=true      # 抽取是否用 LLM（false/失败走启发式规则）

# 阶段 4 Skill Graph / Gap
# GAP_TOP_DEFAULT=50        # 默认最大返回缺口数
# GAP_PREREQ_DECAY=0.5      # 缺失前置降权系数
# GAP_LLM_ENABLED=true      # 是否用 LLM 润色 suggestions（false=模板兜底）

# 阶段 5 学习规划 / Todo
# PLAN_DEFAULT_WEEKLY_HOURS=5    # 默认每周投入小时
# PLAN_PHASES_CAP=8              # 默认最大阶段数
# PLAN_MIN_TASK_HOURS=2          # 单任务小时下限
# PLAN_MAX_TASK_HOURS=12         # 单任务小时上限
# PLAN_HOURS_PER_LEVEL=3         # 每等级差估算小时
# PLAN_LLM_ENABLED=true          # 是否用 LLM 润色 goal/任务文案（false=模板兜底）

# 阶段 6 实践任务与能力评估
# EVAL_STATIC_STRICT=true            # 静态分析是否启用警告级检查
# EVAL_THEORY_WEIGHT=0.4             # theory 在 overall 的权重（practice=1-w）
# EVAL_TRIGGER_REPLAN_DEFAULT=true   # evaluate 默认是否触发缺口再计算+重规划
# EVAL_LLM_ENABLED=true              # 是否用 LLM 润色评估建议（false=模板兜底）
# PRACTICE_DEFAULT_LEVEL_TARGET=3    # 未传 level_target 时的默认目标等级
# PRACTICE_LLM_ENABLED=true          # 是否用 LLM 润色实践指引文案

# 阶段 7 长期记忆与 Middleware
# MEMORY_ENABLED=true                          # 长期记忆总开关（关闭则记忆读写短路为空，不阻断主流程）
# MEMORY_EMBED_ENABLED=true                    # 事实记忆是否向量化（关闭则召回退化为关键词匹配）
# MEMORY_TOP_K=5                               # 语义召回默认 top-k
# MEMORY_SUMMARY_THRESHOLD_MESSAGES=20         # 触发对话摘要压缩的消息轮数阈值
# MEMORY_SUMMARY_LLM_ENABLED=true              # 摘要是否用 LLM 润色（false/失败走模板）
# MEMORY_PII_ENABLED=true                      # 写入记忆前是否脱敏（邮箱/手机/身份证）
# MEMORY_HITL_ENABLED=true                     # 关键操作是否暂停、人工确认
# MEMORY_HITL_EXPIRES_SECONDS=86400            # 待确认动作超时时长

# 阶段 8 前端整合与比赛 Demo
# DEMO_USER_ID=demo_user                       # 演示专用用户
# STREAM_ENABLED=true                          # SSE 流式开关；false 时前端自动走非流式 /chat

# 阶段 9 多 Agent 路由
# ROUTING_LLM_ENABLED=false    # 意图→入参解析是否用 LLM 增强（false/失败走规则，保证可重复；当前实现为纯规则）
# ROUTING_ROLE_LIST_LIMIT=5    # 追问时最多列出的可选岗位数

# 阶段 10 AI 问答式能力评估
# INTERVIEW_LLM_ENABLED=false   # 出题/判分是否用 LLM（false/失败走规则题库，保证可重复演示）
# INTERVIEW_QUESTION_COUNT=5    # 每次访谈题目数
